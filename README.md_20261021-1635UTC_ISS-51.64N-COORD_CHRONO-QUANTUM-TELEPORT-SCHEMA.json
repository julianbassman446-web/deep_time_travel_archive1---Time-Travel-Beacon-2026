import sys
from datetime import datetime


def generate_telemetry_payload(
    latitude: float, longitude: float, altitude_km: float
) -> str:
    """
    Serializes location coordinates and operational steps into a standardized JSON string.
    """
    payload = {
        "telemetry_header": {
            "timestamp": datetime.utcnow().isoformat() + "Z",
            "data_type": "ORBITAL-INTERCEPT-BEACON",
            "routing_protocol": "SECURE-UDP-STREAM",
        },
        "spatial_coordinates": {
            "origin_latitude": latitude,
            "origin_longitude": longitude,
            "target_altitude_km": altitude_km,
            "coordinate_system": "WGS84",
        },
        "operational_manifest": {
            "hardware_handshake": "BLUETOOTH-LOW-MASS-PERIPHERAL-ACTIVE",
            "stabilization_routine": "CASIMIR-FIELD-CALIBRATION-SUCCESSFUL",
            "sequence_steps": [
                "1. Establish stable orbital tracking lock on target vector.",
                "2. Match localized relative velocity vectors to prevent shear.",
                "3. Deploy negative energy flux boundary layer around the payload envelope.",
                "4. Initiate phase-coherent data transit stream.",
            ],
        },
    }

    return json.dumps(payload, indent=2)


def simulate_network_transmission(host: str, port: int, payload_data: str):
    """
    Simulates sending the serialized text payload over a standard TCP/IP network socket.
    """
    print(f"[*] Initializing network socket connection to {host}:{port}...")

    # Encode the string payload into raw bytes for network transport
    byte_payload = payload_data.encode("utf-8")
    payload_size = len(byte_payload)

    print(f"[*] Payload compiled successfully ({payload_size} bytes).")
    print(f"[*] Transmission Log Output:\n{payload_data}\n")

    try:
        # Create a standard Internet stream socket
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as client_socket:
            # Set a short timeout for the local simulation environment
            client_socket.settimeout(3.0)

            # In a real network, this connects to the receiving server
            # For this local simulation example, we catch the connection behavior
            print(f"[~] Attempting to connect to remote node...")
            client_socket.connect((host, port))

            print(f"[+] Connection established. Sending data packet...")
            client_socket.sendall(byte_payload)
            print(f"[+] Transmission complete.")

    except socket.timeout:
        print(
            "[-] Transmission Error: Network connection timed out waiting for remote host reply."
        )
    except ConnectionRefusedError:
        print(
            "[-] Transmission Alert: Connection refused. No active receiver listening on the target port."
        )
    except Exception as e:
        print(f"[-] Unexpected network exception encountered: {e}")


if __name__ == "__main__":
    # Standard geographic coordinates for Philadelphia, PA anchor point
    # Mapping to a theoretical orbital altitude of 420 kilometers (approximate ISS cruise altitude)
    local_lat = 39.9526
    local_lon = -75.1652
    iss_alt_km = 420.0

    # Step 1: Build the data package
    json_packet = generate_telemetry_payload(local_lat, local_lon, iss_alt_km)

    # Step 2: Simulate transmitting the package over network infrastructure
    # Using local loopback (127.0.0.1) and a dummy port (8080) for simulation safety
    simulate_network_transmission(
        host="127.0.0.1", port=8080, payload_data=json_packet
    )
